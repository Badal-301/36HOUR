# ── Confirmation email (SMTP) ─────────────────────────────────
# Fill these in to deliver registration confirmation emails for real.
# While unset, emails are composed and stored in the EmailOutbox table
# ("outbox" mode) and can be previewed via the link on the success screen.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=registrations@yourdomain.edu
# SMTP_PASS=your-app-password
# MAIL_FROM="DEVSPRINT 36 <registrations@yourdomain.edu>"
